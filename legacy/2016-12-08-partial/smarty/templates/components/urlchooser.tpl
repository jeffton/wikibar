<div class="item">
  <table class="urlchooser">

    <tr>
      <td colspan="2">
        <h2>Website</h2>
      </td>
    </tr>
    <tr>
      <td class="urlprefix"><label for="url_website">http://</label></td>
      <td><input type="text" name="url_website" id="url_website" value="{$urlchooser_website}" size="26" /></td>
    </tr>

    <tr>
      <td colspan="2">
        <h2>MySpace</h2>
      </td>
    </tr>
    <tr>
      <td class="urlprefix"><label for="url_myspace">myspace.com/</label></td>
      <td><input type="text" name="url_myspace" id="url_myspace" value="{$urlchooser_myspace}" size="26" /></td>
    </tr>

    <tr>
      <td colspan="2">
        <h2>Facebook {help topic='url_facebook'}</h2>
      </td>
    </tr>
    <tr>
      <td class="urlprefix"><label for="url_facebook">facebook.com/</label></td>
      <td><input type="text" name="url_facebook" id="url_facebook" value="{$urlchooser_facebook}" size="26" /></td>
    </tr>

  </table>
</div>
